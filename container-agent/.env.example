# Artix container agent. It runs on the Docker VM and is called only by the API.
# Full reference: ../docs/configuration.md
#
# The agent does not read .env files by itself. Load this one with systemd
# (EnvironmentFile=/etc/artix/agent.env), with Docker (--env-file) or with Node 20.6 or newer:
#   node --env-file=.env server.js

# Bearer token the API must send (CONTAINER_AGENT_TOKEN on the API side).
# REQUIRED: the agent refuses to start without it. Generate one with: openssl rand -hex 32
AGENT_TOKEN=

# Port the agent listens on. Default: 9090
# AGENT_PORT=9090

# Where deployed apps and their environment files are stored. Defaults: /srv/apps and /srv/env
# APPS_DIR=/srv/apps
# ENV_DIR=/srv/env

# Where Minecraft world backups are stored. Default: /srv/mc-backups
# BACKUP_DIR=/srv/mc-backups

# Host path of Docker's named volumes (file browser and backups of Minecraft servers). Default: /var/lib/docker/volumes
# DOCKER_VOLUMES=/var/lib/docker/volumes

# Sites are served at <subdomain>.APPS_DOMAIN through the reverse proxy. Default: artix.cloud
# APPS_DOMAIN=apps.example.com

# Docker network shared with the reverse proxy. Default: artix-web
# WEB_NETWORK=artix-web

# Memory for image builds, in MB. A build gets at least BUILD_MEM_MB (even on small plans) and never
# more than BUILD_MEM_MAX. It is refused while less than its share plus BUILD_MEM_RESERVE is free on
# the VM. Defaults: 2048 (minimum 512), 2560 (not below BUILD_MEM_MB), 512 (minimum 256).
# BUILD_MEM_MB=2048
# BUILD_MEM_MAX=2560
# BUILD_MEM_RESERVE=512
