# ArtixCloud web app (Next.js). Copy this file to .env.local for local development.
# Full reference: docs/configuration.md. A blank value is the same as unset.
# The Rust API has its own file: backend/.env.example.

# Base URL of the Rust API as seen from the Next.js server. It is never sent to the browser.
# Default: http://127.0.0.1:8080
API_INTERNAL_URL=http://127.0.0.1:8080

# Public WebSocket gateway URL used by the browser, for example wss://app.example.com/ws.
# It is inlined into the browser bundle at BUILD time, so set it before `npm run build`.
# Default: ws(s)://<current host>:8080/ws
# NEXT_PUBLIC_WS_URL=

# Local development over plain http only: "true" removes the Secure flag from the auth cookies.
# Needed on browsers that refuse Secure cookies on http (Safari) or when you browse the dev
# server through a LAN address. Never set it on an internet-facing deployment.
# COOKIE_INSECURE=true
