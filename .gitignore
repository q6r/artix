# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (the pattern also catches stray build output such as backend/.next)
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files: real ones stay on your machine, the *.example templates are committed
.env*
!.env.example

# local tool settings
.claude/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
