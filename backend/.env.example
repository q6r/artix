# ArtixCloud API configuration. Copy this file to backend/.env and fill in the two required secrets below.
#
# Full reference with every default: ../docs/configuration.md
# Check a configuration without starting the server: cargo run -- --check-config
#
# Rules
#   - The real environment wins over this file.
#   - A blank value counts as unset, so the default applies.
#   - Booleans are exactly true or false, in lowercase.
#   - JSON values go in single quotes.
#   - Optional settings are commented out and show their default, or an example when there is no default.
#   - Logging is controlled with the RUST_LOG variable (for example RUST_LOG=debug); it is not listed here.

# ---- Server ----------------------------------------------------------------

# Deployment mode: development, staging or production. Any other value is an error.
# In production the two auth secrets must be at least 32 bytes long and HSTS is sent.
# APP_ENV=development

# Address and port the HTTP server binds to.
# API_HOST=0.0.0.0
# API_PORT=8080

# Browser origins allowed to call the API, comma separated. Use the public URL of the web app.
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Public URL of the web app. Used in links inside emails, after OAuth sign-in and for Stripe redirects.
# PUBLIC_APP_URL=http://localhost:3000

# Public URL under which the API is reachable from the internet. The OAuth callbacks
# (<url>/oauth/<provider>/callback) and the PagCI webhook (<url>/webhooks/pagci) are built from it.
# PUBLIC_API_URL=http://localhost:8080

# ---- Database --------------------------------------------------------------

# MongoDB connection string (a secret when it carries a password) and the database name.
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=artixcloud

# ---- Authentication (required) ---------------------------------------------

# Both are required, secret, and must be stable. Generate each one with: openssl rand -hex 32
# In production they must be at least 32 bytes long.
# AUTH_TOKEN_SECRET signs the access tokens and is also the key that encrypts the GitHub tokens stored in
# the database. AUTH_REFRESH_PEPPER is mixed into the stored hash of refresh tokens.
# Changing either one signs everybody out, and changing the first also makes the stored GitHub tokens unreadable.
AUTH_TOKEN_SECRET=
AUTH_REFRESH_PEPPER=

# Lifetimes in seconds: access token 15 minutes, refresh token 30 days, email links 24 hours,
# passwordless login codes 10 minutes. Each must be greater than 0.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# EMAIL_TOKEN_TTL_SECONDS=86400
# LOGIN_CODE_TTL_SECONDS=600

# ---- Rate limits and lockout -----------------------------------------------

# Requests per minute per client IP: for the whole API, and for the /auth endpoints (stricter). Must be greater than 0.
# RATE_LIMIT_PER_MINUTE=120
# AUTH_RATE_LIMIT_PER_MINUTE=10

# Failed password logins before an account is locked, and how long the lock lasts. Must be greater than 0.
# MAX_FAILED_LOGINS=8
# LOCKOUT_MINUTES=15

# ---- Email (Resend) --------------------------------------------------------

# Resend API key (secret). Empty: emails, login codes included, are written to the log instead of being sent.
# Never leave it empty in production.
# RESEND_API_KEY=

# From header of outgoing email. The default is ArtixCloud <no-reply@artixcloud.com>. The domain must be verified in Resend.
# EMAIL_FROM="ArtixCloud <no-reply@example.com>"

# ---- Sign in with Discord and GitHub ---------------------------------------

# OAuth app credentials. A provider is available when both its id and its secret are set (the secrets are secret).
# Register <PUBLIC_API_URL>/oauth/discord/callback or <PUBLIC_API_URL>/oauth/github/callback with the provider.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Proxmox VE (VPS) ------------------------------------------------------

# Enabled when the API URL, the token id and the token secret are all set. Without them the VPS endpoints answer 503.
# Base URL of the Proxmox API, including the /api2/json path.
# PROXMOX_API_URL=https://pve.example.com:8006/api2/json

# API token id (user@realm!tokenname) and its secret (secret).
# PROXMOX_TOKEN_ID=root@pam!artix
# PROXMOX_TOKEN_SECRET=

# Node that hosts the VMs, VMID of the default template to clone, storage for new disks and network bridge.
# PROXMOX_NODE=pve
# PROXMOX_TEMPLATE_VMID=9000
# PROXMOX_STORAGE=local-lvm
# PROXMOX_BRIDGE=vmbr0

# Template VMID per operating system, as a JSON object. An OS that is not listed uses PROXMOX_TEMPLATE_VMID.
# OS_TEMPLATES='{"Debian 12": 9001, "Ubuntu 24.04": 9002}'

# Storages that may be sold, comma separated (empty: every storage that can hold disk images), and the fraction
# (above 0, up to 1) of a storage's capacity that may be sold as VM disks once the space used by templates is set aside.
# STORAGE_POOL=
# STORAGE_SELL_THRESHOLD=0.8

# Accept an invalid or self-signed TLS certificate from Proxmox. Lab setups only.
# PROXMOX_INSECURE=false

# A Proxmox user limited to VM.Console (for example console@pve) and its password (secret).
# Needed for the serial terminal in the browser, whose login rejects API tokens.
# PROXMOX_CONSOLE_USER=
# PROXMOX_CONSOLE_PASSWORD=

# ---- Public SSH through frp relays -----------------------------------------

# Enabled when FRP_RELAYS is set, or when both FRP_RELAY_HOST and FRP_ADMIN_URL are.
# Relays as a JSON array (preferred, and a secret because it holds tokens). Each relay needs name, host, token,
# admin_url and admin_pass; server_addr, server_port, admin_user, port_min and port_max are optional.
# FRP_RELAYS='[{"name":"relay1","host":"203.0.113.10","token":"change-me","admin_url":"http://127.0.0.1:7400","admin_pass":"change-me"}]'

# A single relay named relay1, set with flat variables instead of FRP_RELAYS.
# Public host of the relay, address that frpc dials (empty: the host) and its port.
# FRP_RELAY_HOST=
# FRP_SERVER_ADDR=
# FRP_SERVER_PORT=7000
# FRP_TOKEN=
# Admin API of the frpc instance on the Proxmox host, with its user and password (secret).
# FRP_ADMIN_URL=
# FRP_ADMIN_USER=artix
# FRP_ADMIN_PASS=
# Range of public SSH ports handed out by this relay. The minimum must not be above the maximum.
# FRP_PORT_MIN=2200
# FRP_PORT_MAX=2300

# ---- Containers (Docker VM agent) ------------------------------------------

# Enabled when both the agent URL and the token are set. The token must equal AGENT_TOKEN on the agent.
# CONTAINER_AGENT_URL=http://203.0.113.20:9090
# CONTAINER_AGENT_TOKEN=

# IP of the Docker VM that the frpc on the Proxmox host dials for Minecraft ports. Empty: the host of CONTAINER_AGENT_URL.
# CONTAINER_VM_IP=

# Public port range handed out to Minecraft servers, separate from the SSH range. The minimum must not be above the maximum.
# MC_PORT_MIN=25565
# MC_PORT_MAX=25764

# Public IP of the relay that fronts customers' own domains (Caddy with on-demand TLS). Customers point an A record at it.
# CUSTOM_DOMAIN_RELAY_IP=

# Base URL GitHub can reach to deliver push webhooks for auto-redeploys. The API adds /webhooks/github/<server id>.
# Empty disables auto-redeploy.
# PUBLIC_WEBHOOK_BASE=

# ---- Cloudflare DNS --------------------------------------------------------

# Enabled when the token and the zone id are both set. Creates the <name>.<zone> records for Minecraft and voice servers.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ZONE_NAME=artix.cloud

# ---- Payments: PIX through PagCI -------------------------------------------

# Enabled when the API URL, the token and the wallet id are all set.
# PAGCI_API_URL=
# PAGCI_API_TOKEN=
# PAGCI_WALLET_ID=
# Wallet name sent with each charge, and the secret that verifies the X-Webhook-Signature of incoming webhooks.
# PAGCI_WALLET_NAME=artix
# PAGCI_WEBHOOK_SECRET=

# ---- Payments: cards through Stripe Checkout -------------------------------

# Enabled when STRIPE_ENABLED is true and the secret key is set. Point the Stripe webhook at <PUBLIC_API_URL>/webhooks/stripe.
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---- Payments: Litecoin through eupa ---------------------------------------

# Enabled when the API key and the wallet id are both set.
# EUPA_API_URL=https://api.eupa.gay
# EUPA_API_KEY=
# EUPA_WALLET_ID=
# Whether eupa charges its fee to the customer (true) instead of to you (false).
# EUPA_FEE_TO_CUSTOMER=true

# ---- Billing ---------------------------------------------------------------

# Currency of plans and invoices.
# BILLING_CURRENCY=BRL

# Run the in-process billing worker (issues renewal invoices, suspends overdue servers). Turn it on for exactly one API instance.
# BILLING_WORKER_ENABLED=false

# Days before the end of a period that the renewal invoice is issued, and days an invoice stays payable
# before the unpaid server is suspended.
# BILLING_RENEW_LEAD_DAYS=3
# BILLING_GRACE_DAYS=3

# Days a server is kept after its expiry date before it is suspended.
# EXPIRY_GRACE_DAYS=3

# Not used by the API today: PagCI decides how long a PIX charge stays valid.
# BILLING_PIX_TTL_SECONDS=86400

# ---- Voice room (LiveKit) --------------------------------------------------

# The shared community voice room in the dashboard. Enabled when the key, the secret and the public URL are all set (the key and the secret are both secret).
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Public wss:// URL that the browser connects to.
# LIVEKIT_URL=wss://livekit.example.com

# Internal URL the API uses to ask LiveKit who is in the room. Empty: the endpoint that lists who is in the call answers 503.
# LIVEKIT_HOST_URL=http://192.0.2.10:7880
